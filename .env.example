# ─────────────────────────────────────────────
# AHUB Nexus - Environment Configuration
# ─────────────────────────────────────────────

# Backend API base URL
# Local dev: http://localhost:8000
# Production: https://api.ahub.in
VITE_API_URL=http://localhost:8000

# When true, images are served from the backend API
# When false/omitted, local bundled assets are used (dev mode)
VITE_USE_API_MEDIA=true

# Sentry DSN for production error monitoring
# Uncomment and set your DSN before deploying to production
# VITE_SENTRY_DSN=https://your-key@sentry.io/project
